{
  "name": "t3d-atmosphere",
  "version": "0.0.1",
  "description": "A library for atmospheric rendering based on t3d.js.",
  "type": "module",
  "main": "./build/t3d.atmosphere.js",
  "module": "./build/t3d.atmosphere.module.js",
  "exports": {
    ".": "./build/t3d.atmosphere.module.js",
    "./src/*": "./src/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uinosoft/t3d-atmosphere"
  },
  "files": [
    "build",
    "LICENSE",
    "package.json",
    "README.md",
    "src"
  ],
  "keywords": [
    "atmosphere",
    "t3d",
    "javascript",
    "3d",
    "webgl",
    "webgl2",
    "canvas",
    "html5"
  ],
  "author": "uino",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@babel/core": "^7.19.1",
    "@babel/preset-env": "^7.19.1",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.0",
    "eslint": "^9.25.1",
    "eslint-plugin-html": "^8.0.0",
    "eslint-plugin-import": "^2.28.1",
    "globals": "^16.0.0",
    "rollup": "^4.9.1"
  },
  "peerDependencies": {
    "t3d": "^0.5.0",
    "t3d-effect-composer": "^0.4.0"
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "lint-examples": "eslint \"examples/**/*.html\"",
    "lint-examples-fix": "eslint \"examples/**/*.html\" --fix",
    "install-examples": "cd examples && npm install --legacy-peer-deps && cd .."
  }
}